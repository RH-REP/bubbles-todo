# Android のビルドに要る2行。~/.zshrc に入れておくと npm run android:build がそのまま通る。
# 入れないと Gradle が SDK と JDK を見つけられない。
export ANDROID_HOME="$HOME/Library/Android/sdk"
# Capacitor 6 が要求する JDK は 17。Android Studio 同梱のものを使えば追加インストールは要らない
# （このMacの同梱は 17.0.6。Capacitor 7 以降は 21 が要る）。
export JAVA_HOME="/Applications/Android Studio.app/Contents/jbr/Contents/Home"
